{
  "name": "float-us-platform",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:hub": "npm run dev --workspace=@float/hub",
    "dev:moving": "npm run dev --workspace=@float/moving",
    "build:hub": "npm run build --workspace=@float/hub",
    "build:moving": "npm run build --workspace=@float/moving",
    "lint": "npm run lint --workspaces --if-present"
  }
}
