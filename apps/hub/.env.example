# Each Float service lives on its own domain in production. Point these at a
# local dev server (e.g. http://localhost:3011) while building locally by
# copying this file to .env.local and adjusting the URLs.
NEXT_PUBLIC_MOVING_URL=https://floatmoving.com
NEXT_PUBLIC_TOWING_URL=https://floattowing.com
NEXT_PUBLIC_FISHING_URL=https://floatjax.com
NEXT_PUBLIC_DETAILING_URL=https://floatdetail.com
